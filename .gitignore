# 1. Environment & Credentials
.env
.env.backup
.env.production
.env.*
!.env.example
auth.json
/storage/*.key

# 2. Dependencies
/vendor
/node_modules
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# 3. Frontend Build & Public Storage
/public/build
/public/hot
/public/storage
/public/fonts-manifest.dev.json

# 4. Storage Runtime, Cache, Sessions & Logs
*.log
/storage/logs/*.log
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*
/storage/pail
.phpunit.result.cache
.phpunit.cache

# Preserve directory structure in storage
!/storage/framework/cache/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
!/storage/app/public/.gitignore

# 5. Local Database
*.sqlite
*.sqlite-journal
database/database.sqlite

